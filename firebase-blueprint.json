{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "loyaltyPoints": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Book": {
      "title": "Book",
      "description": "Book listing information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "genre": { "type": "string" },
        "price": { "type": "number" },
        "condition": { "type": "string" },
        "description": { "type": "string" },
        "coverUrl": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "status": { "type": "string", "enum": ["available", "sold", "reserved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "author", "price", "sellerId", "status"]
    },
    "ChatThread": {
      "title": "Chat Thread",
      "description": "Conversation between buyer and seller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "bookId": { "type": "string" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Review": {
      "title": "Review",
      "description": "User/Seller/Book reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "bookId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Transaction history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "bookId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "User's book wishlist",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/books/{bookId}": { "schema": "Book", "description": "Book listings" },
    "/chatThreads/{threadId}": { "schema": "ChatThread", "description": "Conversations" },
    "/chatThreads/{threadId}/messages/{messageId}": { "schema": "Message", "description": "Messages in a thread" },
    "/reviews/{reviewId}": { "schema": "Review", "description": "Reviews and ratings" },
    "/orders/{orderId}": { "schema": "Order", "description": "Transaction records" },
    "/wishlists/{userId}": { "schema": "Wishlist", "description": "User wishlists" }
  }
}
